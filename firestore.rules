rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /players/{playerId} {
      allow read: if request.auth != null && request.auth.uid == playerId;
      allow create, update: if request.auth != null
        && request.auth.uid == playerId
        && request.resource.data.keys().hasOnly(['level', 'xp', 'tasks', 'updatedAt'])
        && request.resource.data.level is int
        && request.resource.data.level >= 1
        && request.resource.data.level <= 10
        && request.resource.data.xp is int
        && request.resource.data.xp >= 0
        && request.resource.data.tasks is int
        && request.resource.data.tasks >= 0
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
  }
}